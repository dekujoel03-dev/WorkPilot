# Server
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL
# Pooler (port 6543) — runtime API
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — migrations Prisma
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Storage (pièces jointes)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# Redis — désactivé en dev (cache en mémoire)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-in-production-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# App
APP_NAME="Work Pilot"

# AI — ollama (default, local), openai, or mock
AI_PROVIDER=ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
